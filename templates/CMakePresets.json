{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "address-sanitizer",
            "hidden": true,
            "cacheVariables": {
                "ENABLE_ADDRESS_SANITIZER": "ON"
            }
        },
        {
            "name": "thread-sanitizer",
            "hidden": true,
            "cacheVariables": {
                "ENABLE_THREAD_SANITIZER": "ON"
            }
        },
        {
            "name": "realtime-sanitizer",
            "hidden": true,
            "cacheVariables": {
                "ENABLE_REALTIME_SANITIZER": "ON"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "default",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS (Ninja)",
            "inherits": "macos-base"
        },
        {
            "name": "macos-universal",
            "displayName": "macOS Universal Binary (Ninja)",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
            }
        },
        {
            "name": "macos-xcode",
            "displayName": "macOS (Xcode)",
            "inherits": "macos-base",
            "generator": "Xcode"
        },
        {
            "name": "macos-asan",
            "displayName": "macOS Address Sanitizer (Ninja)",
            "inherits": ["macos-base", "address-sanitizer"]
        },
        {
            "name": "macos-tsan",
            "displayName": "macOS Thread Sanitizer (Ninja)",
            "inherits": ["macos-base", "thread-sanitizer"]
        },
        {
            "name": "macos-rtsan",
            "displayName": "macOS Realtime Sanitizer (Ninja)",
            "inherits": ["macos-base", "realtime-sanitizer"]
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "default",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": ["Windows"]
                }
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (Ninja + MSVC)",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "windows-vs",
            "displayName": "Windows (Visual Studio)",
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64"
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "default",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux (Ninja)",
            "inherits": "linux-base"
        },
        {
            "name": "linux-asan",
            "displayName": "Linux Address Sanitizer (Ninja)",
